{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Code Review Report",
  "type": "object",
  "required": ["title", "summary", "merge_readiness", "reviewed_files", "findings", "positives", "unresolved_notes"],
  "properties": {
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "source_label": { "type": ["string", "null"] },
    "generated_at": { "type": ["string", "null"] },
    "merge_readiness": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["ready", "not_ready", "undetermined"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "category", "location", "problem", "related_findings"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "title": { "type": "string" },
          "severity": { "type": ["string", "null"], "enum": ["blocker", "major", "minor", "nit", null] },
          "category": { "type": ["string", "null"], "enum": ["bug", "security", "performance", "readability", "architecture", "test", null] },
          "category_inferred": { "type": "boolean", "default": false },
          "location": {
            "type": "object",
            "required": ["file", "line", "symbol"],
            "properties": {
              "file": { "type": ["string", "null"] },
              "line": { "type": ["string", "integer", "null"] },
              "symbol": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "problem": { "type": "string" },
          "impact": { "type": ["string", "null"] },
          "suggested_fix": { "type": ["string", "null"] },
          "before": { "type": ["string", "null"] },
          "after": { "type": ["string", "null"] },
          "language": { "type": ["string", "null"] },
          "related_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "relationship"],
              "properties": {
                "id": { "type": "string" },
                "relationship": { "enum": ["same_root_cause", "repeated", "causes", "amplifies", "duplicate", "related"] },
                "note": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "source_excerpt": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "positives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "unresolved_notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
